#!/usr/bin/env bash
#
# ccfind - find and resume a Claude Code session, no matter which directory you ran it in.
#
# Claude Code files every session under ~/.claude/projects/<slugified-cwd>/, and
# `claude --resume` only ever offers the sessions belonging to the current directory.
# ccfind searches the prompts you typed across all of them, then resumes the one you
# pick by cd'ing back to its original directory.
#
# Targets bash 3.2 (stock macOS) and needs only jq and system perl.

set -uo pipefail

VERSION="0.2.0"
REPO="erango/ccfind"
TAP="erango/tap/ccfind"

CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
ROOT="$CFG/projects"
CACHE="$CFG/ccfind-cache"
IDX="$CACHE/index.tsv"
MAN="$CACHE/manifest.tsv"
LATEST="$CACHE/latest"

LIMIT=20
LIST_ONLY=0
REINDEX=0

usage() {
  cat <<EOF
ccfind $VERSION - find and resume Claude Code sessions across every directory

usage:
  ccfind <words...>     search the prompts you typed, in every project
  ccfind                list the most recent sessions, in every project
  ccfind -n 40 <words>  cap the number of results (default 20)
  ccfind -l <words>     print a plain list, no picker
  ccfind --reindex      rebuild the prompt index from scratch
  ccfind --version      print the version

Results open in a picker sized to your terminal. Choosing one cd's to that
session's directory and runs \`claude --resume <id>\`.

picker keys:
  up/down, k/j        move            enter           resume the highlighted one
  pgup/pgdn, ^u/^d    page            digits          jump to that number
  g / G               first / last    q, esc          quit

An index of your typed prompts lives in $CACHE and is refreshed
incrementally - only session logs whose mtime changed are re-parsed.

environment:
  CLAUDE_CONFIG_DIR       where Claude Code keeps its data (default ~/.claude)
  CCFIND_NO_UPDATE_CHECK  set to any value to disable the update check
  CCFIND_NO_TUI           set to any value to print a plain list instead
  NO_COLOR                set to any value to disable color
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n) LIMIT="$2"; shift 2 ;;
    -l|--list) LIST_ONLY=1; shift ;;
    --reindex) REINDEX=1; shift ;;
    -V|--version) echo "ccfind $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "ccfind: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done

case "$LIMIT" in
  ''|*[!0-9]*) echo "ccfind: -n wants a number, got '$LIMIT'" >&2; exit 2 ;;
esac

[ -d "$ROOT" ] || { echo "ccfind: no Claude Code session store at $ROOT" >&2; exit 1; }

for dep in jq perl; do
  command -v "$dep" >/dev/null 2>&1 || { echo "ccfind: missing dependency: $dep" >&2; exit 1; }
done

QUERY="$*"

COLOR=1
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then COLOR=0; fi
# Ask the terminal itself: inside $( ) stdout is a pipe, and `tput cols` then
# reports terminfo's default 80 rather than the real width.
WIDTH=$(stty size 2>/dev/null < /dev/tty | cut -d' ' -f2)
case "$WIDTH" in ''|*[!0-9]*|0) WIDTH=$( { tput cols; } 2>/dev/null || echo 80 ) ;; esac
case "$WIDTH" in ''|*[!0-9]*|0) WIDTH=80 ;; esac

# ---------------------------------------------------------------- update check

# Pure-awk dotted-numeric compare; BSD sort has no -V.
version_gt() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".");
    n = (na > nb ? na : nb);
    for (i = 1; i <= n; i++) {
      ai = (i <= na ? x[i] + 0 : 0); bi = (i <= nb ? y[i] + 0 : 0);
      if (ai > bi) { print "1"; exit }
      if (ai < bi) { print "0"; exit }
    }
    print "0"
  }'
}

update_banner() {
  perl -CS -e '
    my ($cur, $new, $tap, $color) = @ARGV;
    my $c = sub { my ($code, $s) = @_; $color ? "\e[${code}m$s\e[0m" : $s };
    my @lines = ("Update available  $cur \x{2192} $new", "brew upgrade $tap");
    my $w = 0; for (@lines) { $w = length($_) if length($_) > $w }
    my $bar = "\x{2500}" x ($w + 4);
    print "\n  ", $c->("2;33", "\x{256D}$bar\x{256E}"), "\n";
    print "  ", $c->("2;33", "\x{2502}"), "  ", $c->("1", $lines[0]),
          " " x ($w - length($lines[0])), "  ", $c->("2;33", "\x{2502}"), "\n";
    print "  ", $c->("2;33", "\x{2502}"), "  ", $c->("36", $lines[1]),
          " " x ($w - length($lines[1])), "  ", $c->("2;33", "\x{2502}"), "\n";
    print "  ", $c->("2;33", "\x{2570}$bar\x{256F}"), "\n\n";
  ' "$VERSION" "$1" "$TAP" "$COLOR" >&2
}

update_check() {
  [ -n "${CCFIND_NO_UPDATE_CHECK:-}" ] && return 0
  command -v curl >/dev/null 2>&1 || return 0

  local now checked tag
  now=$(date +%s)
  checked=0
  tag=""
  if [ -f "$LATEST" ]; then
    IFS='	' read -r checked tag < "$LATEST" || true
    case "$checked" in ''|*[!0-9]*) checked=0 ;; esac
  fi

  # Report from the cache so the hot path never waits on the network.
  if [ -n "$tag" ] && [ "$(version_gt "$tag" "$VERSION")" = "1" ]; then
    update_banner "$tag"
  fi

  # Refresh at most once a day, fully detached; the result shows up next run.
  if [ $((now - checked)) -gt 86400 ]; then
    (
      t=$(curl -fsSL --max-time 5 -H 'Accept: application/vnd.github+json' \
            "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
          | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' \
          | head -1)
      printf '%s\t%s\n' "$(date +%s)" "$t" > "$LATEST.tmp" 2>/dev/null && mv "$LATEST.tmp" "$LATEST"
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------- index refresh

mkdir -p "$CACHE" || exit 1
[ "$REINDEX" -eq 1 ] && rm -f "$IDX" "$MAN"
touch "$IDX" "$MAN"

TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT

# BSD stat and GNU stat disagree on everything except being called stat.
if stat -f '%m' . >/dev/null 2>&1; then
  STAT_FMT=(-f '%N	%m')
else
  STAT_FMT=(-c '%n	%Y')
fi

find "$ROOT" -name '*.jsonl' -type f -exec stat "${STAT_FMT[@]}" {} + 2>/dev/null | sort > "$TMP/manifest"
comm -23 "$TMP/manifest" "$MAN" | cut -f1 > "$TMP/stale"
cut -f1 "$TMP/manifest" > "$TMP/current"

if [ -s "$TMP/stale" ]; then
  [ -t 2 ] && printf '\033[2m  indexing %s session log(s)...\033[0m\r' \
    "$(wc -l < "$TMP/stale" | tr -d ' ')" >&2

  # Carry over rows from logs that are unchanged and still present.
  awk -F'\t' -v s="$TMP/stale" -v c="$TMP/current" '
    FILENAME == s { stale[$0] = 1; next }
    FILENAME == c { cur[$0] = 1; next }
    !($1 in stale) && ($1 in cur)
  ' "$TMP/stale" "$TMP/current" "$IDX" > "$TMP/index"

  # One row per typed prompt: file, timestamp, cwd, session id, prompt text.
  JQ=$(cat <<'EOF'
def text:
  if (.message.content | type) == "string" then .message.content
  else ([.message.content[]? | select(.type == "text") | .text] | join(" "))
  end;
fromjson? // empty
| select(.type == "user" and (.origin.kind // "") == "human")
| . as $m
| (text | gsub("\\s+"; " ")) as $t
| select($t != "")
| [input_filename, $m.timestamp, ($m.cwd // "?"), $m.sessionId, ($t | .[0:2000])]
| @tsv
EOF
)
  tr '\n' '\0' < "$TMP/stale" | xargs -0 jq -rR "$JQ" 2>/dev/null >> "$TMP/index"

  mv "$TMP/index" "$IDX"
  cp "$TMP/manifest" "$MAN"
  [ -t 2 ] && printf '\033[K' >&2
fi

[ -s "$IDX" ] || { echo "ccfind: index is empty - no sessions found under $ROOT" >&2; exit 1; }

# ---------------------------------------------------------------- query

if [ -n "$QUERY" ]; then
  # The prompt that matched wins, newest first.
  grep -i -- "$QUERY" "$IDX" > "$TMP/matched"
else
  # Browsing: a session's opening prompt names the topic far better than
  # whatever "yes" happened to end it.
  sort -t'	' -k2,2 "$IDX" > "$TMP/matched"
fi

awk -F'\t' 'NF && !seen[$4]++' "$TMP/matched" | sort -t'	' -k2,2r > "$TMP/deduped"
TOTAL=$(grep -c . "$TMP/deduped")

head -n "$LIMIT" "$TMP/deduped" > "$TMP/rows"

if [ ! -s "$TMP/rows" ]; then
  printf '\n  \033[33mno sessions match\033[0m \033[1m%s\033[0m\n\n' "$QUERY" >&2
  exit 1
fi

# ---------------------------------------------------------------- render / pick

PERL=$(cat <<'EOF'
use strict;
use warnings;
use POSIX qw(strftime);
use Time::Local qw(timegm);
use IO::Handle;

binmode(STDOUT, ':encoding(UTF-8)');
binmode(STDERR, ':encoding(UTF-8)');

my ($mode, $rowsfile, $query, $color, $width, $total) = @ARGV;
utf8::decode($query);   # @ARGV arrives as bytes; the query may be non-ASCII
$color = ($color eq '1');
$total = 0 + $total;

my %C = (DIM => '2', NUM => '1;36', DIR => '1;38;5;213', HIT => '1;30;43',
         TIME => '38;5;245', SEL => '1;38;5;213');
sub c { my ($code, $s) = @_; return $color ? "\e[${code}m$s\e[0m" : $s }

sub clamp_width { my $w = shift; $w = 40 if $w < 40; $w = 110 if $w > 110; return $w }

sub ago {
    my ($ts) = @_;
    my @p = $ts =~ /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)/
        or return (substr($ts, 0, 16), '');
    my $epoch = eval { timegm($p[5], $p[4], $p[3], $p[2], $p[1] - 1, $p[0]) };
    return (substr($ts, 0, 16), '') unless defined $epoch;
    my $d = time - $epoch;
    my $rel = $d <   3600 ? int($d / 60)    . "m ago"
            : $d <  86400 ? int($d / 3600)  . "h ago"
            : $d < 604800 ? int($d / 86400) . "d ago"
            :               strftime("%b %d", localtime($epoch));
    return ($rel, strftime("%H:%M", localtime($epoch)));
}

# Slash-command prompts are stored as XML; show them the way they were typed.
sub clean {
    my ($t) = @_;
    if ($t =~ m{<command-name>\s*([^<]*)</command-name>}) {
        my $name = $1;
        my $args = ($t =~ m{<command-args>\s*([^<]*)</command-args>}) ? $1 : '';
        for ($name, $args) { s/^\s+//; s/\s+$// }
        $t = length($args) ? "$name $args" : $name;
    }
    $t =~ s{</?command-[a-z]+>}{ }g;
    $t =~ s/^\s+//;
    $t =~ s/\s+$//;
    return $t;
}

sub highlight {
    my ($s) = @_;
    return $s unless $color && length $query;
    my $q = quotemeta($query);
    $s =~ s/($q)/c($C{HIT}, $1)/gie;
    return $s;
}

sub wrap {
    my ($s, $w, $max) = @_;
    my @words = grep { length } split /\s+/, $s;
    my (@lines, $cur);
    $cur = '';
    while (@words) {
        my $word = shift @words;
        if (length($word) > $w) {           # hard-break long URLs
            unshift @words, substr($word, $w);
            $word = substr($word, 0, $w);
        }
        if    ($cur eq '')                             { $cur = $word }
        elsif (length($cur) + 1 + length($word) <= $w) { $cur .= " $word" }
        else                                           { push @lines, $cur; $cur = $word }
        last if @lines == $max;
    }
    if (@lines < $max && $cur ne '') { push @lines, $cur; $cur = '' }
    if (@lines && ($cur ne '' || @words)) {
        $lines[-1] = substr($lines[-1], 0, $w - 1) . "\x{2026}";
    }
    return @lines;
}

open(my $rfh, '<:encoding(UTF-8)', $rowsfile) or die "ccfind: cannot read rows\n";
my @rows;
while (my $l = <$rfh>) {
    chomp $l;
    next unless $l =~ /\S/;
    push @rows, [ split /\t/, $l, 5 ];
}
close $rfh;
exit 0 unless @rows;

my $home = $ENV{HOME} // '';
my $BODY = 3;    # prompt lines shown per session

sub item_lines {
    my ($i, $row, $w, $sel) = @_;
    my (undef, $ts, $cwd, undef, $text) = @$row;
    $text = '' unless defined $text;
    my $path = $cwd;
    $path =~ s/^\Q$home\E/~/ if length $home;
    my ($head, $base) = $path =~ m{^(.*/)([^/]*)$} ? ($1, $2) : ('', $path);
    my ($rel, $clock) = ago($ts);
    my $stamp = length($clock) ? "$rel  $clock" : $rel;

    # the index is printed in a 2-wide field, so measure what is actually drawn
    my $num = sprintf("%2d", $i);
    my $pad = $w - 4 - length($num) - length($path) - length($stamp);
    $pad = 1 if $pad < 1;

    my $lead = $sel ? c($C{SEL}, "\x{25B8}") . " " : "  ";
    my $gut  = $sel ? c($C{SEL}, "\x{2503} ")      : c($C{DIM}, "\x{2502} ");

    my @out = ($lead . c($C{NUM}, $num) . "  " . c($C{DIM}, $head) . c($C{DIR}, $base)
               . (" " x $pad) . c($C{TIME}, $stamp));
    push @out, "      " . $gut . highlight($_) for wrap(clean($text), $w - 8, $BODY);
    return @out;
}

sub item_height {   # header + prompt lines + the blank line after
    my ($row, $w) = @_;
    my $text = defined $row->[4] ? $row->[4] : '';
    return 2 + scalar(wrap(clean($text), $w - 8, $BODY));
}

sub header_text {
    my $label = length($query) ? "matching \"$query\"" : "most recent";
    my $tail  = $total > @rows ? " \x{00B7} showing " . scalar(@rows) . " of $total" : "";
    return "\x{256D}\x{2500} claude sessions \x{00B7} $label$tail";
}

sub render_static {
    my ($fh) = @_;
    my $w = clamp_width($width);
    print {$fh} "\n  ", c($C{DIM}, header_text()), "\n\n";
    for my $i (0 .. $#rows) {
        print {$fh} "$_\n" for item_lines($i + 1, $rows[$i], $w, 0);
        print {$fh} "\n";
    }
}

# ---------------------------------------------------------------- the picker

sub tty_size {
    my $s = `stty size < /dev/tty 2>/dev/null`;
    return ($1, $2) if defined $s && $s =~ /(\d+)\s+(\d+)/;
    # no terminal (a pipe, or CI): honour LINES/COLUMNS if they are set
    return (($ENV{LINES} || 24), ($ENV{COLUMNS} || 80));
}

# One screen's worth of lines, and the scroll offset that keeps $sel visible.
sub screen_lines {
    my ($sel, $top, $height, $w, $numbuf) = @_;
    my @h = map { item_height($rows[$_], $w) } 0 .. $#rows;

    my $avail = $height - 4;        # header, blank, blank, hint
    $avail = 3 if $avail < 3;

    my $fits = sub {                # last index visible when starting at $_[0]
        my ($from) = @_;
        my ($sum, $last) = (0, $from);
        for my $i ($from .. $#rows) {
            last if $sum + $h[$i] > $avail && $i > $from;
            $sum += $h[$i];
            $last = $i;
        }
        return $last;
    };

    $top = $sel if $sel < $top;
    $top = $#rows if $top > $#rows;
    $top++ while $top < $sel && $fits->($top) < $sel;

    my $last = $fits->($top);
    my @lines = ("  " . c($C{DIM}, header_text()), "");
    for my $i ($top .. $last) {
        push @lines, item_lines($i + 1, $rows[$i], $w, $i == $sel), "";
    }
    pop @lines if @lines && $lines[-1] eq "";

    my $keys = length($numbuf)
        ? "go to $numbuf \x{00B7} enter resume \x{00B7} esc clear"
        : "\x{2191}\x{2193} move \x{00B7} enter resume \x{00B7} digits jump \x{00B7} q quit";
    my $shown = sprintf("%s %d of %d %s",
        $top > 0 ? "\x{2191}" : " ", $sel + 1, scalar @rows,
        $last < $#rows ? "\x{2193}" : " ");
    my $pad = $w - 2 - length($keys) - length($shown);
    $pad = 1 if $pad < 1;
    push @lines, "", "  " . c($C{DIM}, $keys) . (" " x $pad) . c($C{TIME}, $shown);

    return ($top, \@lines);
}

sub read_key {
    my ($fh) = @_;
    my $b;
    return undef unless sysread($fh, $b, 1);
    return $b unless $b eq "\e";
    my $rin = ''; vec($rin, fileno($fh), 1) = 1;
    return "\e" unless select($rin, undef, undef, 0.06) > 0;
    my $c2;
    return "\e" unless sysread($fh, $c2, 1);
    return "\e" unless $c2 eq '[' || $c2 eq 'O';
    my $seq = '';
    while (1) {
        my $r = ''; vec($r, fileno($fh), 1) = 1;
        last unless select($r, undef, undef, 0.06) > 0;
        my $ch;
        last unless sysread($fh, $ch, 1);
        $seq .= $ch;
        last if $ch =~ /[A-Za-z~]/;
    }
    return "\e[$seq";
}

# No usable terminal: fall back to the plain list plus a typed number.
sub fallback_pick {
    render_static(\*STDERR);
    print STDERR "  resume [1-" . scalar(@rows) . "] or q > ";
    my $ans = <STDIN>;
    return -1 unless defined $ans;
    chomp $ans;
    return -1 unless $ans =~ /^\d+$/ && $ans >= 1 && $ans <= @rows;
    return $ans - 1;
}

sub pick {
    # Two handles on the same terminal: sysread() refuses a :utf8 handle, but
    # the drawing side has to emit box-drawing characters as UTF-8.
    my ($tin, $tty);
    open($tin, '<',  '/dev/tty') or return fallback_pick();
    open($tty, '>>', '/dev/tty') or return fallback_pick();
    binmode($tty, ':encoding(UTF-8)');
    $tty->autoflush(1);

    my $saved = `stty -g < /dev/tty 2>/dev/null`;
    chomp $saved;
    my $done = 0;
    my $restore = sub {
        return if $done;
        $done = 1;
        print {$tty} "\e[?25h\e[?1049l";
        system("stty $saved < /dev/tty") if length $saved;
    };
    $SIG{INT} = $SIG{TERM} = sub { $restore->(); exit 130 };

    # -icanon -echo for key-at-a-time input, but keep output post-processing
    # so a plain "\n" still returns the cursor to column 0.
    system("stty -icanon -echo -isig min 1 time 0 < /dev/tty");
    print {$tty} "\e[?1049h\e[?25l";

    my ($sel, $top, $numbuf, $chosen) = (0, 0, '', undef);
    while (1) {
        my ($h, $w) = tty_size();
        my $lines;
        ($top, $lines) = screen_lines($sel, $top, $h, clamp_width($w), $numbuf);
        print {$tty} "\e[H", join("\e[K\n", @$lines), "\e[K\n\e[J";

        my $k = read_key($tin);
        last unless defined $k;

        if    ($k eq "\e[A" || $k eq 'k')                { $sel--;     $numbuf = '' }
        elsif ($k eq "\e[B" || $k eq 'j')                { $sel++;     $numbuf = '' }
        elsif ($k eq "\e[5~" || $k eq "\x15")            { $sel -= 5;  $numbuf = '' }
        elsif ($k eq "\e[6~" || $k eq "\x04")            { $sel += 5;  $numbuf = '' }
        elsif ($k eq "\e[H" || $k eq 'g')                { $sel = 0;   $numbuf = '' }
        elsif ($k eq "\e[F" || $k eq 'G')                { $sel = $#rows; $numbuf = '' }
        elsif ($k eq "\r" || $k eq "\n")                 { $chosen = $sel; last }
        elsif ($k eq 'q' || $k eq "\e" || $k eq "\x03")  { last }
        elsif ($k =~ /^[0-9]$/) {
            (my $try = $numbuf . $k) =~ s/^0+//;
            if (length($try) && $try <= @rows) { $numbuf = $try; $sel = $try - 1 }
        }
        elsif ($k eq "\x7f" || $k eq "\b") {
            $numbuf = substr($numbuf, 0, -1);
            $sel = $numbuf - 1 if length($numbuf);
        }
        $sel = 0      if $sel < 0;
        $sel = $#rows if $sel > $#rows;
    }

    $restore->();
    return defined $chosen ? $chosen : -1;
}

if ($mode eq 'static') {
    render_static(\*STDOUT);
    exit 0;
}

# One static frame of the picker, for the README captures and the tests.
if ($mode eq 'frame') {
    my ($h, $w) = tty_size();
    my $sel = ($ENV{CCFIND_TUI_FRAME_SEL} || 1) - 1;
    my (undef, $lines) = screen_lines($sel, 0, $h, clamp_width($w), '');
    print "$_\n" for @$lines;
    exit 0;
}

my $idx = pick();
exit 0 if $idx < 0;
print "$rows[$idx][2]\t$rows[$idx][3]\n";
EOF
)

if [ -n "${CCFIND_TUI_FRAME:-}" ]; then
  # internal: one static frame of the picker, for the README captures and tests
  perl -e "$PERL" -- frame "$TMP/rows" "$QUERY" "$COLOR" "$WIDTH" "$TOTAL"
  exit 0
fi

if [ "$LIST_ONLY" -eq 0 ] && [ -z "${CCFIND_NO_TUI:-}" ] && [ -t 0 ] && [ -t 1 ]; then
  PICKED=$(perl -e "$PERL" -- pick "$TMP/rows" "$QUERY" 1 "$WIDTH" "$TOTAL")
  update_check
  [ -n "$PICKED" ] || exit 0
  cwd=${PICKED%%	*}
  sid=${PICKED##*	}
  [ -d "$cwd" ] || { printf '\n  \033[33mgone:\033[0m %s\n\n' "$cwd" >&2; exit 1; }
  printf '\n  \033[2mresuming in\033[0m \033[1;38;5;213m%s\033[0m\n\n' "${cwd/#$HOME/\~}"
  cd "$cwd" || exit 1
  exec claude --resume "$sid"
fi

perl -e "$PERL" -- static "$TMP/rows" "$QUERY" "$COLOR" "$WIDTH" "$TOTAL"
update_check
